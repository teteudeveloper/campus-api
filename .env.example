# Modelo de configuração local. Prefira gerar o .env real com: ./scripts/configurar-ambiente-local.sh
# (segredos aleatórios, permissão 600). Nunca versione o .env.

# PostgreSQL (administrador/dono do schema; usado pelo Flyway e para manutenção).
# Em volume já inicializado, estes valores não alteram contas existentes: rode ./scripts/db-provisionar.sh.
POSTGRES_DB=campus_api
POSTGRES_USER=campus_user
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

# Usuário de runtime da API (somente SELECT/INSERT/UPDATE/DELETE)
APP_DB_USER=campus_app
APP_DB_PASSWORD=

APP_PORT=8080

# Chave HMAC do JWT em Base64, mínimo 256 bits: openssl rand -base64 32
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P7D

# Primeiro administrador (criado só se não existir nenhum ADMIN). 10 a 64 caracteres, letras e dígitos.
# Remova após o primeiro login e a troca de senha.
BOOTSTRAP_ADMIN_LOGIN=
BOOTSTRAP_ADMIN_PASSWORD=

# Origens do CORS separadas por vírgula, sem curingas. Vazio = nenhuma origem externa.
CORS_ALLOWED_ORIGINS=

# Swagger/OpenAPI: true apenas em ambiente local ou não exposto
SWAGGER_ENABLED=true

# Atrás de proxy reverso confiável: native
FORWARD_HEADERS_STRATEGY=none

# Somente na adoção única de banco criado pela versão anterior (ver README > Migrações)
FLYWAY_BASELINE_ON_MIGRATE=false
